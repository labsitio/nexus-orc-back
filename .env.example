# Postgres local (docker-compose.yml). Em AWS, DATABASE_URL aponta para o
# Aurora Serverless v2 via RDS Proxy (não versionar credenciais reais).
POSTGRES_DB=nexo
POSTGRES_USER=nexo
POSTGRES_PASSWORD=nexo
POSTGRES_PORT=5432
DATABASE_URL=postgresql://nexo:nexo@localhost:5432/nexo

# LocalStack (S3 + EventBridge + SQS/SNS) — integração local, spec 001/README.
# O AWS SDK v3 lê AWS_ENDPOINT_URL nativamente: os mesmos gateways de produção
# passam a falar com o LocalStack sem nenhuma troca de adaptador.
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
LOCALSTACK_PORT=4566
LOCALSTACK_DEBUG=0

# Execução local do fluxo 001→002 (T067/#589) — `pnpm dev:seed` e `pnpm dev`.
# Nomes iguais aos das stacks CDK: divergir aqui invalida o teste local.
NEXO_BUCKET_RAW=nexo-orcamentos-raw
NEXO_EVENT_BUS=nexo-dominio-bus
PORT=3000
# Confiança devolvida pelo classificador local (Bedrock não roda no LocalStack):
# >=80 leva a CLASSIFICADO, <80 a PENDENTE_REVISAO_HUMANA.
NEXO_LOCAL_CONFIANCA=90
# true deixa `condicoesPagamento` sem extrair, forçando o escalonamento de 002.
NEXO_LOCAL_EXTRACAO_CAMPO_FALTANDO=false
# Substituto local do TenantContextMiddleware (sem Cognito em dev, src/dev/local.ts):
# UUID v7 fixo usado como `tenantId` de toda requisição local. NEXO_LOCAL_PAPEIS
# substitui a claim cognito:groups — lista separada por vírgula. Defaults cobrem
# os papéis exigidos por todas as rotas gated (comprador-responsavel,
# compliance-admin), então nenhuma rota local fica bloqueada por papel.
NEXO_LOCAL_TENANT_ID=018f4a3c-0000-7000-8000-000000000001
NEXO_LOCAL_PAPEIS=comprador-responsavel,compliance-admin
# Seleciona o gateway de IA em dev: local (heurística determinística, sem custo,
# `src/dev/local.ts`) ou bedrock (Amazon Bedrock real). Contrato definido no
# ADR-009 (#617). `criarAgenteClassificador` (composition root) monta o
# gateway Ollama real quando chamado com agenteIa="local" — ver docs/poc-ollama-classificador.md.
NEXO_AGENTE_IA=local
# Ollama (issue #617) — só usado quando algo chama criarAgenteClassificador
# com agenteIa="local" fora do stub determinístico de src/dev/local.ts.
OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODELO_CLASSIFICADOR=llama3.1
# Sem env var própria em produção (selecionarAgenteExtrator não tem default) —
# se ausente, src/dev/local.ts cai no mesmo modelo do classificador.
OLLAMA_MODELO_EXTRATOR=llama3.1
# Ollama (issue #620) — embedding local, alternativa ao Titan V2 (Bedrock).
# Restrição dura: o schema pgvector já criado
# (indice-orcamento.schema.ts) fixa 1024 dimensões — mxbai-embed-large
# é o único modelo Ollama de embedding compatível (nomic-embed-text tem 768
# e NÃO serve). Ver docs/poc-ollama-embedding.md.
OLLAMA_MODELO_EMBEDDING=mxbai-embed-large
# Ollama (issue #621) — mesmo modelo de chat já usado pelo classificador (#617).
OLLAMA_MODELO_ORQUESTRADOR=llama3.1
# Ollama (issue #746) — interpretação de consulta em linguagem natural, mesmo
# modelo de chat do classificador se não informado.
OLLAMA_MODELO_INTERPRETADOR=llama3.1

# Observabilidade (T015/#20) — logging pino + OpenTelemetry Node SDK.
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
