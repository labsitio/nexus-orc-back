# Postgres local (docker-compose.yml). Em AWS, DATABASE_URL aponta para o
# Aurora Serverless v2 via RDS Proxy (não versionar credenciais reais).
POSTGRES_DB=nexo
POSTGRES_USER=nexo
POSTGRES_PASSWORD=nexo
POSTGRES_PORT=5432
DATABASE_URL=postgresql://nexo:nexo@localhost:5432/nexo

# LocalStack (S3 + EventBridge + SQS/SNS) — integração local, spec 001/README.
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
LOCALSTACK_PORT=4566
LOCALSTACK_DEBUG=0

# Observabilidade (T015/#20) — logging pino + OpenTelemetry Node SDK.
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
